{
  "_docs": {
    "purpose": "Per-firm configuration. Each key is a firmId used in the webhook URL: /webhooks/quo/{firmId}/{event}",
    "onboarding": "To add a new firm, add an entry here AND set the FIRM_<UPPERCASE_ID>_* environment variables listed under 'requiredEnvVars' below.",
    "requiredEnvVars": [
      "FIRM_<ID>_QUO_API_KEY",
      "FIRM_<ID>_SLACK_BOT_TOKEN",
      "FIRM_<ID>_SLACK_TEXT_MESSAGES_WEBHOOK_URL",
      "FIRM_<ID>_SLACK_MISSED_CALLS_WEBHOOK_URL",
      "FIRM_<ID>_SLACK_HUMAN_CALLS_WEBHOOK_URL",
      "FIRM_<ID>_SLACK_SONA_CALLS_WEBHOOK_URL",
      "FIRM_<ID>_SLACK_LEAD_CALLS_WEBHOOK_URL",
      "FIRM_<ID>_SLACK_LEAD_CALLS_CHANNEL_ID",
      "FIRM_<ID>_SLACK_LEGAL_ASSISTANT_WEBHOOK_URL",
      "FIRM_<ID>_SLACK_LEGAL_ASSISTANT_CHANNEL_ID"
    ],
    "optionalEnvVars": [
      "FIRM_<ID>_SLACK_USER_TOKEN (admin xoxp- token — sets Slack status to On a call)",
      "FIRM_<ID>_REPORT_API_TOKEN (bearer token for /api/reports/:firmId/availability-misses)"
    ],
    "globalEnvVars": ["OPENAI_API_KEY (or ANTHROPIC_API_KEY)", "OPENAI_MODEL (optional)", "DEFAULT_FIRM_ID", "PORT", "DATABASE_URL", "REPORT_API_TOKEN"]
  },
  "examplefirm": {
    "name": "Example Law Firm",
    "practiceArea": "personal injury",
    "phoneLines": {
      "+15551234567": "Main Line",
      "+15551234568": "Outbound"
    },
    "leadThreadTagUsers": ["U00000000", "U11111111"],
    "phoneStaff": [
      { "name": "Jackie", "slackUserId": "U00000000", "quoUserId": "US00000000" }
    ]
  }
}
